router.post('/track-prediction', async (req, res) => {
  try {
    const userId = req.user.id;
    const user = await getUserFromDatabase(userId);

    // Check if user has predictions remaining
    if (user.predictionsLimit !== -1 && user.predictionsUsed >= user.predictionsLimit) {
      return res.status(403).json({ 
        error: 'Prediction limit reached',
        message: 'Please upgrade your plan to make more predictions'
      });
    }

    // Increment prediction count
    await incrementPredictionCount(userId);

    res.json({ 
      success: true,
      predictionsUsed: user.predictionsUsed + 1,
      predictionsLimit: user.predictionsLimit
    });
  } catch (error) {
    console.error('Prediction tracking error:', error);
    res.status(500).json({ error: 'Failed to track prediction' });
  }
});

router.get('/subscription-status', async (req, res) => {
  try {
    const userId = req.user.id;
    const user = await getUserFromDatabase(userId);

    res.json({
      tier: user.tier || 'free',
      status: user.subscriptionStatus || 'inactive',
      predictionsUsed: user.predictionsUsed || 0,
      predictionsLimit: user.predictionsLimit || 10,
      periodEnd: user.currentPeriodEnd
    });
  } catch (error) {
    console.error('Status check error:', error);
    res.status(500).json({ error: 'Failed to get subscription status' });
  }
});

