### 10. Usage Tracking Implementation

#### Middleware for Prediction Endpoints

```javascript
// middleware/checkPredictionLimit.js
async function checkPredictionLimit(req, res, next) {
  const userId = req.user.id;
  const user = await getUserFromDatabase(userId);

  // Unlimited plans (-1)
  if (user.predictionsLimit === -1) {
    return next();
  }

  // Check if limit exceeded
  if (user.predictionsUsed >= user.predictionsLimit) {
    return res.status(403).json({
      error: 'PREDICTION_LIMIT_REACHED',
      message: 'You have reached your monthly prediction limit',
      upgrade: true,
      currentPlan: user.tier
    });
  }

  // Attach user data to request
  req.subscriptionData = user;
  next();
}

// Apply to prediction route
app.post('/api/predict', authenticate, checkPredictionLimit, async (req, res) => {
  // Make prediction
  const result = await makePrediction(req.body);
  
  // Increment count
  await incrementPredictionCount(req.user.id);
  
  res.json({
    prediction: result,
    predictionsRemaining: req.subscriptionData.predictionsLimit - req.subscriptionData.predictionsUsed - 1
  });
});
```

